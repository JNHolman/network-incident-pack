# Optional NetBox read-only inventory lookup
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=replace-with-api-token

# Optional ServiceNow incident work-note update
SERVICENOW_URL=https://instance.service-now.com
SERVICENOW_USER=replace-with-api-user
SERVICENOW_PASSWORD=replace-with-password

# Optional read-only Azure Resource Manager enrichment
# Prefer exporting a short-lived token at runtime rather than storing one in a file.
AZURE_ACCESS_TOKEN=replace-with-short-lived-arm-token
